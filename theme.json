{
  "name": "Virtual Controller Office Dark Theme",
  "dataColors": [
    "#6366F1",
    "#10B981",
    "#F59E0B",
    "#EF4444",
    "#38BDF8",
    "#8B5CF6",
    "#94A3B8",
    "#64748B"
  ],
  "background": "#0F172A",
  "foreground": "#F8FAFC",
  "tableAccent": "#6366F1",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#0F172A" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E293B" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#334155" } },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "bold": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}
