# ==============================================================================
# Virtual Controller Office — Environment Configuration Template
# Copy this file to .env and insert your actual API keys and path settings.
# NOTE: Never commit your actual .env file containing live secrets to git.
# ==============================================================================

# 1. Google Gemini API Configuration (Model reasoning & agent deliberation)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Serper Web Search API (Live external market rate benchmarking)
SERPER_API_KEY=your_serper_api_key_here
ENABLE_LIVE_WEB_RESEARCH=true

# 3. Local LLM Runtime (Ollama / LM Studio)
OLLAMA_HOST=127.0.0.1:11434

# 4. DuckDB Analytical Database Path
DUCKDB_PATH=data/controller_office.duckdb

# 5. Local Integration Paths
OneDrive=C:\Users\username\OneDrive
